# Copy to .env.local for local development, or set these in your hosting
# environment for production. Use different values in each — never reuse
# development credentials in production.

# Login for the /admin content editor (single admin account).
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Where the SQLite content database is stored. Defaults to ./.data/cms.db.
# In Docker this is /data/cms.db — mount a volume there so edits survive redeploys.
# CMS_DB_PATH=/data/cms.db
